    local jobId = nil
    pcall(function()
        local ServerBrowser = ReplicatedStorage:WaitForChild("__ServerBrowser")
        jobId = ServerBrowser:InvokeServer("getjob")
    end)
    
    if not jobId then
        jobId = game.JobId
    end
    
    -- Collect comprehensive server data
    self.ServerInfo = {
        JobId = jobId,
        ServerName = generateServerName(jobId),
        PlaceId = game.PlaceId,
        PlaceVersion = game.PlaceVersion,
        GameTime = os.time(),
        MaxPlayers = Players.MaxPlayers,
        CurrentPlayers = #Players:GetPlayers(),
        ServerAge = math.floor(game:GetService("Workspace").DistributedGameTime / 60)
    }
    
    -- Collect player data
    self.PlayerInfo = {}
    for _, player in pairs(Players:GetPlayers()) do
        local playerData = {
            UserId = player.UserId,
            Name = player.Name,
            DisplayName = player.DisplayName,
            AccountAge = player.AccountAge,
            Membership = player.MembershipType.Name,
            Level = 0,
            Bounty = 0,
            Fruits = {}
        }
        
        -- Try to get leaderstats
        pcall(function()
            if player:FindFirstChild("leaderstats") then
                local stats = player.leaderstats
                
                -- Get level
                if stats:FindFirstChild("Level") then
                    playerData.Level = stats.Level.Value
                elseif stats:FindFirstChild("Lvl") then
                    playerData.Level = stats.Lvl.Value
                end
                
                -- Get bounty
                if stats:FindFirstChild("Bounty") then
                    playerData.Bounty = stats.Bounty.Value
                elseif stats:FindFirstChild(" Bounty") then
                    playerData.Bounty = stats[" Bounty"].Value
                end
            end
        end)
        
        table.insert(self.PlayerInfo, playerData)
    end
    
    return self.ServerInfo
end

