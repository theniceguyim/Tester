# ===== LAYER 2: OBFUSCATION & IDENTITY RANDOMIZATION =====
class ShadowIdentity:
    """Generate randomized fingerprints and UUIDs"""
    
    def __init__(self):
        self.hw_id = self.get_hardware_id()
        self.session_id = self.generate_session_id()
        
    def get_hardware_id(self) -> str:
        """Generate hardware fingerprint"""
        try:
            import uuid
            import platform
            import hashlib
            
            # Combine multiple system identifiers
            identifiers = [
                platform.node(),
                str(uuid.getnode()),
                platform.processor(),
                platform.machine()
            ]
            
            combined = ''.join(identifiers).encode()
            return hashlib.sha256(combined).hexdigest()[:16]
        except:
            return self.generate_random_hash()
    
    def generate_session_id(self) -> str:
        """Create unique session identifier"""
        timestamp = int(time.time() * 1000)
        random_part = ''.join(random.choices(string.ascii_letters + string.digits, k=12))
        return f"{timestamp:X}{random_part}"
    
    def generate_fake_id(self) -> str:
        """Generate fake Roblox user ID"""
        prefix = random.choice(["USER_", "PLAYER_", "ROBLOX_"])
        numbers = ''.join(random.choices(string.digits, k=9))
        return f"{prefix}{numbers}"
    
    def generate_random_hash(self, length: int = 16) -> str:
        """Generate random hexadecimal hash"""
        return ''.join(random.choices('0123456789abcdef', k=length))

